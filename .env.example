# .env — Environment variables for IDML News Extractor API
# Copy this file to .env and fill in your values.
# Never commit .env to git — it contains credentials.

# ============================================================================
# APPLICATION
# ============================================================================
APP_ENV=production
DEBUG=false

# ============================================================================
# SERVER
# ============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=2

# CORS — allowed browser origins (your WordPress domain, admin tools, etc.)
# Watcher-to-API calls are server-to-server and are NOT affected by CORS.
ALLOWED_ORIGINS=https://your-wordpress-site.com

ALLOWED_HOSTS=*
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# FILE UPLOAD
# ============================================================================
MAX_UPLOAD_SIZE_MB=200
TEMP_DIR=/tmp/idml-uploads

# ============================================================================
# WORDPRESS
# To get an Application Password:
#   WordPress Admin → Users → Your Profile → Application Passwords → Add New
# ============================================================================
WORDPRESS_URL=https://your-wordpress-site.com/wp-json/wp/v2/posts
WORDPRESS_USERNAME=your-wp-username
WORDPRESS_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WORDPRESS_CATEGORIES_URL=https://your-wordpress-site.com/wp-json/wp/v2/categories?per_page=100
WORDPRESS_AUTHORS_URL=https://your-wordpress-site.com/wp-json/wp/v2/users?per_page=100
WORDPRESS_MEDIA_URL=https://your-wordpress-site.com/wp-json/wp/v2/media

# Master switch — set to false for dry-run (parse only, do not post)
WORDPRESS_ENABLE_POSTING=true

# ============================================================================
# SECURITY
# Generate a random key: python -c "import secrets; print(secrets.token_hex(32))"
# The same key must be set in the watcher (IDML_API_KEY env var or watcher.py)
# ============================================================================
REQUIRE_AUTH=true
API_KEY=change-me-to-a-random-secret-string

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=
